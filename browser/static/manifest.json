{
  "manifest_version": 3,
  "name": "nfltr nf1",
  "version": "0.1.0",
  "description": "Opens an nf1 address end to end: the relay carries the session and can't read it.",
  "action": { "default_title": "Open an nf1 address" },
  "background": { "service_worker": "bg.js", "scripts": ["bg.js"] },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'none'; base-uri 'none'"
  },
  "browser_specific_settings": {
    "gecko": { "id": "nf1@nfltr.xyz", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  }
}
