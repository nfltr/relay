(* Copyright 2026 nfltr
   SPDX-License-Identifier: Apache-2.0

   enrol.pv: enrolment through an organisation root of trust.
   spec/proverif/README.md.

   The organisation root (its primary key on the owner's machine, behind
   Touch ID) certifies an issuer; the issuer (the enrolment signer, on the
   owner's machine, under the owner's policy) gives each machine a
   short-lived x509 certificate: name, public key, serial, expiry, group.
   A machine makes its own key and redeems a single-use bootstrap token
   that names it; it renews with its current key. Clients take a peer
   "signed by the organisation with name X"; services admit "an
   organisation certificate in group Y"; both check expiry and the
   issuer's current CRL. A stolen root is replaced by a rotation statement
   signed by the offline recovery key.

   The attacker owns the relay: every enrolment request and answer, every
   certificate, CRL and rotation statement it carries (it can replay an
   old CRL or withhold a new one). It also holds: an enrolled machine's key
   (mallory), a revoked stolen laptop's key (lost), a rotated-out key of
   web whose certificate has expired, the bootstrap token of a machine not
   yet enrolled (new1), and the old root's primary key. Signatures and
   HMAC are ideal. Time is three epochs: ep_now (the verifier's clock),
   ep_grace (a name's newest certificate, expired less than orgpki
   RenewGrace ago: the issuer still renews it, no verifier admits it) and
   ep_old (anything else that has expired, a superseded serial however
   recent, a CRL past its NextUpdate).

   Bindings (org/orgpki rebind_test.go TestRebindModelBindings, one row
   each: the field changed in the honest request, as a relay can):
     BIND:rebind.mac  the new machine's key is bound to the rebind token by its HMAC (org/orgpki Enrol)
     BIND:rebind.name the certificate names the token's name, never the request's (org/orgpki rebind)
     BIND:move.id     a move's new relay machine id is under the current key's signature (org/orgpki Renew, lane SEAMLESS)
     BIND:enrol.id    a join's stated relay machine id is under the token's HMAC (org/orgpki Enrol, lane LOGINREDS)

   A reissue (lane REISSUE, nfltr docs/decisions/org-reissue-2026-11-22.md:
   a rebind token to the name's own relay machine id, made only while the
   name holds no valid certificate) is RebindRedeem: the same token, HMAC
   and name binding, no new field; its precondition is the issuer's state
   (spec/enrol/Enrol.tla ReissueRetiresOnlyExpired).

   The code: org/orgpki (README "Code map"); every query
   it enforces has a test there, and testdata/mutants.txt plants the
   mutants below in the Go code (make test-go-mutants). *)

free c: channel.                      (* the relay *)

type skey.
type pkey.
type mname.
type epoch.
type group.

fun pk(skey): pkey.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), pk(k)) = m.
reduc forall m: bitstring, k: skey; getmess(sign(m, k)) = m.
fun hmac(bitstring, bitstring): bitstring.

free web, mallory, lost, new1: mname.
free ep_old, ep_grace, ep_now: epoch.
free g_db, g_other: group.
free none, s_lost: bitstring.          (* serials are public *)
free rid_web: bitstring.               (* web's new relay machine id (it enrolled with the relay again) *)
free jid_web: bitstring.               (* the relay machine id web states when it joins *)

(* x509 (crypto/x509): the issuer's CA certificate, a machine's leaf
   (DNS SAN <name>.<org>.internal, OU the group, NotAfter), a CRL
   (ThisUpdate/NextUpdate as its epoch, one revoked serial here), and the
   rotation statement (a cross-signed certificate of the new root). *)
fun issuercert(pkey): bitstring [data].
fun leaf(mname, pkey, bitstring, epoch, group): bitstring [data].
fun crl(epoch, bitstring): bitstring [data].
fun rotation(pkey): bitstring [data].
fun renewal(pkey): bitstring [data].   (* a CSR for the new key, signed with the current one *)
fun moving(pkey, bitstring): bitstring [data]. (* the same, naming a new relay machine id (a move) *)
fun stating(pkey, bitstring): bitstring [data]. (* what a join's id HMAC covers: its key (the CSR) and the relay machine id, domain-separated from the enrolment HMAC (orgpki enrolIDMAC) *)

free skRoot: skey [private].           (* the root's current primary *)
free skOld: skey [private].            (* the old root's primary: stolen, below *)
free skRec: skey [private].            (* the recovery key, offline *)
free skIss: skey [private].            (* the issuer *)

event TokenMade(bitstring, mname).
event RebindTokenMade(bitstring, mname).
event Rebound(bitstring, mname, pkey).
event Enrolled(bitstring, mname, pkey).
event Reissued(bitstring, mname, pkey).
event Holds(mname, pkey).              (* an honest machine made this key for its name *)
event Issued(mname, pkey, bitstring, epoch, group).
event Revoked(mname).
event Accepted(mname, pkey, bitstring, epoch).
event Admitted(mname, pkey).
event Renewed(mname, epoch).        (* the issuer renewed a certificate of that epoch *)
event Repeated(mname).              (* the issuer answered a renewal asked again (lane CANARYCERT) *)

(* The issuer's log, as far as the repeat and lane REISSUE's rejected
   design read it: renewedFor(s, k), the name's newest serial renewed s for
   key k; newer(s, s'), s' is a newer serial of s's name; presented(s), the
   issuer took a renewal from s (through the relay, which chooses). *)
table renewedFor(bitstring, pkey).
table newer(bitstring, bitstring).
table presented(bitstring).
event AsksMove(mname, bitstring).   (* the name's machine asks, with its key, to move to that relay id *)
event Moved(mname, bitstring).      (* the issuer moved the name to that relay id *)
event AsksBind(mname, bitstring).   (* the name's machine states that relay id, under the token's HMAC, when it joins *)
event Bound(mname, bitstring).      (* the issuer certified the name for that relay id at its enrolment *)
event IssuerCertified(pkey).
event RecoverySigned(pkey).
event RotatedTo(pkey).
event TrustsIssuer(pkey).

(* The issuer redeems a token once: the name and group are the token's,
   fixed when the owner made it for a name not enrolled; the request binds
   the machine's key to the token by an HMAC, so the relay never sees the
   token and cannot attach another key to it. *)
(* A login bundle's token names no relay machine id (lane LOGINREDS,
   spec/enrol/Join.tla JoinedBound): the join states its own (rid; none
   when it states none) under the token's HMAC (mi), and the issuer
   certifies the name for it; the relay cannot put an id of its choosing
   (mutant bind-id-unmacd: the id beside the HMAC, the relay's to change).
   The move policy (the id is the issuer's account machine of the name)
   is the relay's word and the attacker's here, as for a move. *)
let Redeem(t: bitstring, n: mname, g: group) =
  new s: bitstring;
  in(c, (nr: mname, k: pkey, m: bitstring, rid: bitstring, mi: bitstring));
  if m = hmac(t, (nr, k)) then        (* NOT:token-in-request *)
  if m = t then                        (* ONLY:token-in-request *)
  let nn = n in                        (* NOT:name-from-request *)
  let nn = nr in                       (* ONLY:name-from-request *)
  if rid = none || mi = hmac(t, stating(k, rid)) then   (* NOT:bind-id-unmacd *)
  event Bound(nn, rid);
  event Enrolled(t, nn, k);
  event Issued(nn, k, s, ep_now, g);
  out(c, sign(leaf(nn, k, s, ep_now, g), skIss));
  (* Asked again for the key it enrolled (its answer lost, or late: the
     join kept its key), the token is answered again, a new serial of
     that key; any other key is refused (spec/enrol/Join.tla Issue; the
     revoke and a renewal since are that model's state). *)
  !(new s2: bitstring;
    in(c, (nr2: mname, k2: pkey, m2: bitstring));
    if m2 = hmac(t, (nr2, k2)) then
    if k2 = k then                     (* NOT:reissue-any-key *)
    event Reissued(t, nn, k2);
    event Issued(nn, k2, s2, ep_now, g);
    out(c, sign(leaf(nn, k2, s2, ep_now, g), skIss))).

(* A rebind (nfltr docs/decisions/org-rebind-2026-11-17.md; RFC 7030
   simplereenroll): the owner's single-use rebind token names an enrolled
   name and the new relay machine id; the machine of that id redeems it
   as an enrolment (the HMAC binds its key), and the issuer certifies the
   token's name, never the request's (mutant rebind-any-name), retiring
   the name's earlier serials (spec/enrol/Enrol.tla Rebind). *)
let RebindRedeem(t: bitstring, n: mname, g: group) =
  new s: bitstring;
  in(c, (nr: mname, k: pkey, m: bitstring));
  if m = hmac(t, (nr, k)) then
  let nn = n in                        (* NOT:rebind-any-name *)
  let nn = nr in                       (* ONLY:rebind-any-name *)
  event Rebound(t, nn, k);
  event Issued(nn, k, s, ep_now, g);
  out(c, sign(leaf(nn, k, s, ep_now, g), skIss)).

(* web: its token delivered by the fleet's provisioning (cloud-init, a
   k8s secret, MDM), not by the relay. *)
let WebMachine(t: bitstring) =
  new sk: skey;
  event Holds(web, pk(sk));
  event AsksBind(web, none);           (* a certificate naming no id is web's too: the keeper moves it *)
  event AsksBind(web, jid_web);
  out(c, (web, pk(sk), hmac(t, (web, pk(sk))), jid_web, hmac(t, stating(pk(sk), jid_web)))).   (* NOT:token-in-request *)
  out(c, (web, pk(sk), t, jid_web, hmac(t, stating(pk(sk), jid_web)))).                        (* ONLY:token-in-request *)

(* Renewal: the current certificate and a CSR for the new key signed with
   the current one; refused for a revoked certificate and an expired one
   but the name's newest within the grace (spec/enrol/Enrol.tla Renews). *)
let Renew =
  new s2: bitstring;                   (* before the input: the serial is the issuer's, not a function of the request *)
  in(c, (cert: bitstring, k2: pkey, pop: bitstring));
  let leaf(n, k, s, e, g) = checksign(cert, pk(skIss)) in
  if e = ep_now || e = ep_grace then   (* NOT:renew-expired *)
  if s <> s_lost then                  (* NOT:renew-revoked *)
  if checksign(pop, k) = renewal(k2) then
  insert presented(s);
  event Renewed(n, e);
  event Issued(n, k2, s2, ep_now, g);
  out(c, sign(leaf(n, k2, s2, ep_now, g), skIss)).

(* A renewal asked again (lane CANARYCERT, spec/enrol/Enrol.tla Repeat,
   nfltr docs/decisions/org-renew-answer-again-2026-11-22.md): a superseded
   expired serial, within the grace, that the name's newest serial renewed
   for the key the CSR names is renewed again, for that key only (mutant
   repeat-any-key: any key, so the old disk's rotated-out key renews). *)
let Repeat =
  new s2: bitstring;
  in(c, (cert: bitstring, k2: pkey, pop: bitstring));
  let leaf(n, k, s, e, g) = checksign(cert, pk(skIss)) in
  if e = ep_old then
  get renewedFor(=s, kn) in
  if k2 = kn then                      (* NOT:repeat-any-key *)
  if checksign(pop, k) = renewal(k2) then
  event Repeated(n);
  event Issued(n, k2, s2, ep_now, g);
  out(c, sign(leaf(n, k2, s2, ep_now, g), skIss)).

(* Lane REISSUE's rejected zero-action recovery (design A, mutant
   reissue-unpresented; spec/enrol/Enrol.tla Unpresented): a superseded
   expired serial is renewed for any key when its newer serial was never
   presented to the issuer. The relay withholds web's renewal from its
   newer certificate and hands over the old disk's: query 2 fails. *)
let Unpresented =                      (* ONLY:reissue-unpresented *)
  new s2: bitstring;                   (* ONLY:reissue-unpresented *)
  in(c, (cert: bitstring, k2: pkey, pop: bitstring));   (* ONLY:reissue-unpresented *)
  let leaf(n, k, s, e, g) = checksign(cert, pk(skIss)) in   (* ONLY:reissue-unpresented *)
  if e = ep_old then                   (* ONLY:reissue-unpresented *)
  get newer(=s, sn) in                 (* ONLY:reissue-unpresented *)
  get presented(=sn) in 0 else         (* ONLY:reissue-unpresented *)
  if checksign(pop, k) = renewal(k2) then   (* ONLY:reissue-unpresented *)
  event Issued(n, k2, s2, ep_now, g);  (* ONLY:reissue-unpresented *)
  out(c, sign(leaf(n, k2, s2, ep_now, g), skIss)).   (* ONLY:reissue-unpresented *)

(* A move (lane SEAMLESS; nfltr docs/decisions/seamless-certificates-2026-11-20.md):
   a renewal that names the machine's new relay machine id (it enrolled
   with the relay again), signed with the current key over the new key
   and the id; the issuer then certifies the name for that id and retires
   its earlier serials (spec/enrol/Enrol.tla Move). Its policy (the id is
   a machine of the issuer's own account with that name) is the relay's
   word and the attacker's here: the key's signature over the id is what
   the relay cannot forge (mutant move-id-unsigned: the id beside the
   signed renewal, the relay's to change). *)
let Move =
  new s2: bitstring;
  in(c, (cert: bitstring, k2: pkey, rid: bitstring, pop: bitstring));
  let leaf(n, k, s, e, g) = checksign(cert, pk(skIss)) in
  if e = ep_now || e = ep_grace then
  if s <> s_lost then
  if checksign(pop, k) = moving(k2, rid) then   (* NOT:move-id-unsigned *)
  if checksign(pop, k) = renewal(k2) then       (* ONLY:move-id-unsigned *)
  event Moved(n, rid);
  event Issued(n, k2, s2, ep_now, g);
  out(c, sign(leaf(n, k2, s2, ep_now, g), skIss)).

(* A client dialing the service of machine x (the pin "signed by the
   organisation root with name x"): chain to the root, name, expiry, a
   current CRL from the same issuer that does not list the serial. The TLS
   1.3 handshake then binds the session to the holder of k (assumed). *)
let Client =
  in(c, x: mname);
  in(c, (icert: bitstring, lcert: bitstring, crlm: bitstring));
  let issuercert(ki) = checksign(icert, pk(skRoot)) in   (* NOT:no-chain-check *)
  let issuercert(ki) = getmess(icert) in                 (* ONLY:no-chain-check *)
  let leaf(n, k, s, e, g) = checksign(lcert, ki) in
  if n = x then                        (* NOT:no-name-check *)
  if e = ep_now then                   (* NOT:no-expiry-check *)
  let crl(ce, r) = checksign(crlm, ki) in   (* NOT:crl-any-signer *)
  let crl(ce, r) = getmess(crlm) in        (* ONLY:crl-any-signer *)
  if ce = ep_now then                  (* NOT:stale-crl *)
  if s <> r then                       (* NOT:no-crl-check *)
  event Accepted(x, k, s, e).

(* A service admitting clients of group g_db (allow_client "an
   organisation certificate in group db"): the same verification, and the
   group. *)
let Service =
  in(c, (icert: bitstring, lcert: bitstring, crlm: bitstring));
  let issuercert(ki) = checksign(icert, pk(skRoot)) in   (* NOT:no-chain-check *)
  let issuercert(ki) = getmess(icert) in                 (* ONLY:no-chain-check *)
  let leaf(n, k, s, e, g) = checksign(lcert, ki) in
  if e = ep_now then                   (* NOT:no-expiry-check *)
  let crl(ce, r) = checksign(crlm, ki) in   (* NOT:crl-any-signer *)
  let crl(ce, r) = getmess(crlm) in        (* ONLY:crl-any-signer *)
  if ce = ep_now then                  (* NOT:stale-crl *)
  if s <> r then                       (* NOT:no-crl-check *)
  if g = g_db then                     (* NOT:no-group-check *)
  event Admitted(n, k).

(* A machine still pinned to the old root (its primary stolen) and the
   recovery key: it moves to the root a rotation statement names, then
   trusts issuers under that root only. A join with pins made before the
   rotation takes the root the same way (orgenrol.trust). *)
let RotClient =
  in(c, rm: bitstring);
  let rotation(kn) = checksign(rm, pk(skRec)) in         (* NOT:rotate-by-primary *)
  let rotation(kn) = checksign(rm, pk(skOld)) in         (* ONLY:rotate-by-primary *)
  event RotatedTo(kn);
  in(c, icert: bitstring);
  let issuercert(ki) = checksign(icert, kn) in           (* NOT:keep-old-root *)
  let issuercert(ki) = checksign(icert, pk(skOld)) in    (* ONLY:keep-old-root *)
  event TrustsIssuer(ki).

let Setup =
  (* web's previous key: rotated out, its certificate expired, the key leaked *)
  new sko: skey; new so: bitstring;
  event Holds(web, pk(sko));
  event Issued(web, pk(sko), so, ep_old, g_db);
  out(c, sign(leaf(web, pk(sko), so, ep_old, g_db), skIss)); out(c, sko);
  (* web's current certificate, expired within the grace (the machine was
     off, or the issuer out of reach, through its renewal window): web
     renews it with its own key, never leaked *)
  new skg: skey; new sg: bitstring; new skn: skey;
  event Holds(web, pk(skg)); event Holds(web, pk(skn));
  event Issued(web, pk(skg), sg, ep_grace, g_db);
  out(c, (sign(leaf(web, pk(skg), sg, ep_grace, g_db), skIss), pk(skn), sign(renewal(pk(skn)), skg)));
  (* sg renewed so for web's key skg: the log the repeat reads *)
  insert renewedFor(so, pk(skg)); insert newer(so, sg);
  (* ... and, enrolled with the relay again (a new relay machine id), asks
     with the same key to move its name there *)
  event AsksMove(web, rid_web);
  out(c, (sign(leaf(web, pk(skg), sg, ep_grace, g_db), skIss), pk(skn), rid_web, sign(moving(pk(skn), rid_web), skg)));
  (* mallory: enrolled, then compromised (not revoked) *)
  new skm: skey; new sm: bitstring;
  event Holds(mallory, pk(skm));
  event Issued(mallory, pk(skm), sm, ep_now, g_other);
  out(c, sign(leaf(mallory, pk(skm), sm, ep_now, g_other), skIss)); out(c, skm);
  (* lost: a stolen laptop in group db, revoked *)
  new skl: skey;
  event Holds(lost, pk(skl));
  event Issued(lost, pk(skl), s_lost, ep_now, g_db);
  event Revoked(lost);
  out(c, sign(leaf(lost, pk(skl), s_lost, ep_now, g_db), skIss)); out(c, skl);
  (* the CRL before the revoke (now past its NextUpdate) and the current one *)
  out(c, sign(crl(ep_old, none), skIss));
  out(c, sign(crl(ep_now, s_lost), skIss));
  (* the issuer's certificate, signed by the root after Touch ID *)
  event IssuerCertified(pk(skIss));
  out(c, sign(issuercert(pk(skIss)), skRoot));
  (* the old root's primary was stolen; the recovery key rotated to skRoot *)
  out(c, skOld);
  event RecoverySigned(pk(skRoot));
  out(c, sign(rotation(pk(skRoot)), skRec)).

(* 1. no name without the root: every accepted name and key was issued *)
query n: mname, k: pkey, s: bitstring, e: epoch, g: group;
  event(Accepted(n, k, s, e)) ==> event(Issued(n, k, s, e, g)).
(* 2. a client taking web reaches a key web made *)
query k: pkey, s: bitstring, e: epoch; event(Accepted(web, k, s, e)) ==> event(Holds(web, k)).
(* 3. an expired certificate is refused *)
query n: mname, k: pkey, s: bitstring; event(Accepted(n, k, s, ep_old)) ==> false.
(* 4. a revoked machine is refused, also after it tries to renew *)
query n: mname, k: pkey, s: bitstring, e: epoch; event(Accepted(n, k, s, e)) && event(Revoked(n)) ==> false.
(* 5. a token enrols one key (single use) *)
query t: bitstring, n: mname, k: pkey; inj-event(Enrolled(t, n, k)) ==> inj-event(TokenMade(t, n)).
(* 6. a token enrols only the name it was made for (never an existing one) *)
query t: bitstring, n: mname, k: pkey; event(Enrolled(t, n, k)) ==> event(TokenMade(t, n)).
(* 7. a service admits only certificates issued in its group *)
query n: mname, k: pkey, s: bitstring, e: epoch; event(Admitted(n, k)) ==> event(Issued(n, k, s, e, g_db)).
(* 8. a rotation is taken only when the recovery key signed it *)
query k: pkey; event(RotatedTo(k)) ==> event(RecoverySigned(k)).
(* 9. after the rotation, only issuers the new root certified *)
query k: pkey; event(TrustsIssuer(k)) ==> event(IssuerCertified(k)).
(* 10. a token answered again certifies only the key it enrolled *)
query t: bitstring, n: mname, k: pkey; event(Reissued(t, n, k)) ==> event(Enrolled(t, n, k)).
(* 11. a rebind token rebinds only the enrolled name it was made for (6
   for a rebind: a leaked rebind token moves its own name, never another) *)
query t: bitstring, n: mname, k: pkey; event(Rebound(t, n, k)) ==> event(RebindTokenMade(t, n)).
(* 12-18. witnesses (1, 7, 6, 8, 9, 10, 11 not vacuous): web reached; a
   client admitted; the leaked token's own name enrolled by whoever
   redeems it first (the stated residual: one name, once, and web's
   provisioning then fails visibly); a rotation; an issuer trusted after
   it; web's token answered again (its request replayed) *)
query k: pkey, s: bitstring; event(Accepted(web, k, s, ep_now)).
query n: mname, k: pkey; event(Admitted(n, k)).
query t: bitstring, k: pkey; event(Enrolled(t, new1, k)).
query k: pkey; event(RotatedTo(k)).
query k: pkey; event(TrustsIssuer(k)).
query t: bitstring, k: pkey; event(Reissued(t, web, k)).
query t: bitstring, n: mname, k: pkey; event(Rebound(t, n, k)).
(* 19. witness: web's certificate renewed in the grace *)
query event(Renewed(web, ep_grace)).
(* 20. web's name moves only to a relay machine id web asked for with its
   key (the relay cannot move it to an id of its choosing) *)
query r: bitstring; event(Moved(web, r)) ==> event(AsksMove(web, r)).
(* 21. witness: web's name moved to its new relay machine id *)
query event(Moved(web, rid_web)).
(* 22. web's name is certified at its enrolment only for the relay
   machine id web stated (or none, AsksBind(web, none)): the relay cannot bind an id of its
   choosing (BIND:enrol.id) *)
query r: bitstring; event(Bound(web, r)) ==> event(AsksBind(web, r)).
(* 23. witness: web's name certified for the relay machine id it stated *)
query event(Bound(web, jid_web)).
(* 24. witness: a renewal of web asked again answered again (Repeat; 2
   holds with it: the answer is for web's key skg, never the old disk's) *)
query event(Repeated(web)).

process
  Setup |
  (new tw: bitstring; event TokenMade(tw, web); (Redeem(tw, web, g_db) | WebMachine(tw))) |
  (new t1: bitstring; event TokenMade(t1, new1); out(c, t1); Redeem(t1, new1, g_other)) |   (* NOT:reusable-token *)
  (new t1: bitstring; event TokenMade(t1, new1); out(c, t1); !Redeem(t1, new1, g_other)) |  (* ONLY:reusable-token *)
  (* mallory's rebind token, leaked: its holder moves mallory (enrolled,
     its key the attacker's already), once *)
  (new tr: bitstring; event RebindTokenMade(tr, mallory); out(c, tr); RebindRedeem(tr, mallory, g_other)) |
  (!Unpresented) |                     (* ONLY:reissue-unpresented *)
  (!Repeat) | (!Renew) | (!Move) | (!Client) | (!Service) | (!RotClient)
