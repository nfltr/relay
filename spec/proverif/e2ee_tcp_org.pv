(* Copyright 2026 nfltr
   SPDX-License-Identifier: Apache-2.0

   e2ee_tcp_org.pv: pinned TCP sessions in organisation mode (lane ORG2,
   nfltr docs/decisions/org-enrolment-2026-11-09.md "Paths that change",
   first row): the agent ends TLS with its machine certificate, issued
   under the organisation's root; a client names the machine (nfltr dial
   web/pg, to: web/pg on a connect: mapping) and checks the chain and the
   name, no pin; a service admits a client certificate under the same
   root, in one of its allow_group groups, neither expired nor on the
   issuer's CRL. spec/proverif/README.md "e2ee_tcp_org.pv".

   Beside e2ee_tcp.pv (pins), which stays until the hard cut (lane
   ORGCUT): a service and a client are each in one mode, set by their own
   configuration, never by the relay, and never fall back to the other
   (the downgrade mutants below).

   The attacker owns the relay(s): the open, the answer, the certificate a
   session presents, every byte. It holds the keys of: eve (enrolled, live,
   group web: not the service's group), lost (group db, revoked: its serial
   on the CRL), old (group db, expired), and two of web's own (an expired
   one and a revoked one). enrol.pv proves who can get a certificate of the
   organisation (only the issuer under the root, for a token's own name);
   here the organisation's signing key is one private key, orgk, and a
   certificate is its signature over (name, group, key, serial, validity).
   The CRL the verifier holds lists serWebRev and serLost; validity live or
   expired is the verifier's clock against NotAfter. Time and re-checks
   (a session ends at Identity.Until, a newer CRL cuts what it lists) are
   nfltr spec/enrol/Enrol.tla's NoExpiredSession and RevocationBound, not
   here. TLS 1.3 is not re-proven (e2ee_tcp.pv's note).

   Code (nfltr = github.com/nfltr/nfltr; the rest github.com/nfltr/relay):
     nfltr internal/application/orgpki/verify.go Check   chain to the root, name, groups, CRL, NotAfter
     client/agent/org.go Org.CheckClient                 the service's check (nfltr: orgpki behind it)
     client/agent/org.go orgServerConfig                 RequireAnyClientCert + VerifyConnection, no fallback
     client/agent/services.go resolve                    an org service has no pins, takes no plain session
     nfltr cmd/nfltr/internal/transportcli/org_session.go the client: ServerName <name>.<org>.internal, the check *)

free c: channel.

type skey.
type pkey.
fun pk(skey): pkey.
fun aenc(bitstring, pkey): bitstring.
reduc forall m: bitstring, k: skey; adec(aenc(m, pk(k)), k) = m.
fun senc(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; sdec(senc(m, k), k) = m.
fun sign(bitstring, skey): bitstring.
reduc forall m: bitstring, k: skey; checksign(sign(m, k), pk(k)) = m.
reduc forall m: bitstring, k: skey; getmsg(sign(m, k)) = m.    (* a certificate's contents are public *)
fun h(bitstring): bitstring.

const c2s, s2c: bitstring.
const answerOK, answerPinOnly: bitstring.     (* the relay's word: accepted; "the service is pinned" *)
const live, expired: bitstring.
const nameWeb, nameCli, nameEve, nameLost, nameOld: bitstring.
const grpDb, grpWeb: bitstring.
const serWeb, serWebOld, serWebRev, serCli, serEve, serLost, serOld: bitstring.
const noCert: bitstring.                      (* a client that presents no organisation certificate *)

free orgk: skey [private].                    (* the organisation: root, then issuer (enrol.pv) *)
free skWeb, skCli: skey [private].
free payload: bitstring [private].            (* what the client sends machine web *)
free svcData: bitstring [private].            (* what web's service answers an admitted client *)

event ClientAccepted(bitstring).                       (* the serial of the server certificate the client took *)
event ClientSent(bitstring, bitstring).                (* its own serial, its bytes *)
event ClientRecv(bitstring, bitstring).                (* session key, response *)
event AgentSent(bitstring, bitstring).                 (* session key, response *)
event ServiceGot(bitstring, bitstring).                (* the admitted client's serial, its bytes *)

(* The client, in organisation mode: names machine web; no pin. *)
let Client(certCli: bitstring) =
  out(c, (nameWeb, true));                             (* the open: web's service, E2Ee *)
  in(c, answer: bitstring);
  if answer = answerPinOnly then out(c, payload) else (* ONLY:downgrade-plain *)
  if answer = answerOK then
  in(c, (scert: bitstring, spk: pkey));                (* the session's certificate and key *)
  let (sn: bitstring, sg: bitstring, =spk, ss: bitstring, se: bitstring) = checksign(scert, pk(orgk)) in (* NOT:client-no-chain-check *)
  let (sn: bitstring, sg: bitstring, =spk, ss: bitstring, se: bitstring) = getmsg(scert) in (* ONLY:client-no-chain-check *)
  if sn = nameWeb then                                 (* the name it asked for *) (* NOT:no-name-check *)
  if se = live then                                    (* NotAfter *) (* NOT:client-no-expiry-check *)
  if ss <> serWebRev && ss <> serLost then             (* the CRL *) (* NOT:client-no-crl-check *)
  event ClientAccepted(ss);
  new k: bitstring;
  out(c, aenc(k, spk));
  out(c, (certCli, sign(h((k, spk)), skCli)));          (* Certificate + CertificateVerify *)
  event ClientSent(serCli, payload);
  out(c, senc((c2s, payload), k));
  in(c, e: bitstring);
  let (=s2c, r: bitstring) = sdec(e, k) in
  event ClientRecv(k, r).

(* Web's agent: a tcp service in organisation mode, allow_group db. *)
let Agent(certWeb: bitstring) =
  in(c, (target: bitstring, e2ee: bool));
  if e2ee = true then                                  (* a plain session is refused *)
  out(c, (certWeb, pk(skWeb)));
  in(c, ek: bitstring);
  let k = adec(ek, skWeb) in
  in(c, (ccert: bitstring, cv: bitstring));
  if ccert = noCert then (in(c, e0: bitstring); let (=c2s, m0: bitstring) = sdec(e0, k) in event ServiceGot(noCert, m0); out(c, senc((s2c, svcData), k))) else (* ONLY:downgrade-any-client *)
  let (cn: bitstring, cg: bitstring, cpk: pkey, cs: bitstring, ce: bitstring) = checksign(ccert, pk(orgk)) in (* NOT:agent-no-chain-check *)
  let (cn: bitstring, cg: bitstring, cpk: pkey, cs: bitstring, ce: bitstring) = getmsg(ccert) in (* ONLY:agent-no-chain-check *)
  if cg = grpDb then                                   (* allow_group *) (* NOT:no-group-check *)
  if ce = live then                                    (* NotAfter *) (* NOT:agent-no-expiry-check *)
  if cs <> serWebRev && cs <> serLost then             (* the CRL *) (* NOT:agent-no-crl-check *)
  if checksign(cv, cpk) = h((k, pk(skWeb))) then       (* CertificateVerify (crypto/tls) *)
  in(c, e: bitstring);
  let (=c2s, m: bitstring) = sdec(e, k) in
  event ServiceGot(cs, m);
  new r: bitstring;
  event AgentSent(k, (r, svcData));
  out(c, senc((s2c, (r, svcData)), k)).

(* 1. the client's bytes reach only machine web: not eve (another name),
   not a certificate the relay made, not web's expired or revoked key, not
   in plain on the relay's word (mutants client-no-chain-check, no-name-check,
   client-no-expiry-check, client-no-crl-check, downgrade-plain) *)
(* expect true *)
query attacker(payload).
(* 2. what the client takes as web's answer, web's agent sent in that session *)
(* expect true *)
query k: bitstring, r: bitstring; inj-event(ClientRecv(k, r)) ==> inj-event(AgentSent(k, r)).
(* 3, 4, 5. the server certificates the client refuses: another name, revoked, expired *)
(* expect true *)
query event(ClientAccepted(serEve)).
(* expect true *)
query event(ClientAccepted(serWebRev)).
(* expect true *)
query event(ClientAccepted(serWebOld)).
(* 6. the service's answer reaches only an admitted client (mutants
   agent-no-chain-check, no-group-check, agent-no-expiry-check,
   agent-no-crl-check, downgrade-any-client: an organisation service
   that serves a client without an organisation certificate, the pin
   mode's "no list") *)
(* expect true *)
query attacker(svcData).
(* 7. what reaches the service was sent by an admitted client *)
(* expect true *)
query s: bitstring, m: bitstring; event(ServiceGot(s, m)) ==> event(ClientSent(s, m)).
(* 8, 9, 10. the clients the service refuses: outside its group, revoked, expired *)
(* expect true *)
query m: bitstring; event(ServiceGot(serEve, m)).
(* expect true *)
query m: bitstring; event(ServiceGot(serLost, m)).
(* expect true *)
query m: bitstring; event(ServiceGot(serOld, m)).
(* 11, 12. witnesses: an allowed client reaches the service, and gets its answer *)
(* expect false *)
query m: bitstring; event(ServiceGot(serCli, m)).
(* expect false *)
query k: bitstring, r: bitstring; event(ClientRecv(k, r)).

process
  new skEve: skey; new skLost: skey; new skOld: skey; new skWebOld: skey; new skWebRev: skey;
  let certWeb = sign((nameWeb, grpWeb, pk(skWeb), serWeb, live), orgk) in
  let certCli = sign((nameCli, grpDb, pk(skCli), serCli, live), orgk) in
  out(c, certWeb); out(c, certCli);
  out(c, (skEve, sign((nameEve, grpWeb, pk(skEve), serEve, live), orgk)));
  out(c, (skLost, sign((nameLost, grpDb, pk(skLost), serLost, live), orgk)));
  out(c, (skOld, sign((nameOld, grpDb, pk(skOld), serOld, expired), orgk)));
  out(c, (skWebOld, sign((nameWeb, grpWeb, pk(skWebOld), serWebOld, expired), orgk)));
  out(c, (skWebRev, sign((nameWeb, grpWeb, pk(skWebRev), serWebRev, live), orgk)));
  ((!Agent(certWeb)) | (!Client(certCli)))
