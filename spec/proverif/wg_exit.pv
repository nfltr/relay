(* Copyright 2026 nfltr
   SPDX-License-Identifier: Apache-2.0

   wg_exit.pv: Track B, a WireGuard client and its exit (nfltr wg connect,
   wg socks5 <-> an agent's wgexit). spec/proverif/README.md "wg_exit.pv".

   The attacker owns the relay(s), the network and every key the relay hands
   out: x-wg-peer-pubkey and x-wg-peer-key-id to the client, PeerUpdate to
   the exit, x-wg-paired to both. With two relays (client on one, exit on
   another, or a relay rerouting the client to a third machine) the attacker
   owns both: one Dolev-Yao attacker is the colluding case and so covers
   each alone.

   Noise IKpsk2 (WireGuard) is not re-proven: a handshake between static key
   a and the peer key B it was told, with preshared key p, gives the
   transport key kdf(DH(a,B), DH(ephemerals), p) known only to the holder of
   B's private key that uses the same p (Donenfeld and Milner, Tamarin 2017;
   Dowling and Paterson, ACNS 2018; Lipp, Blanchet and Bhargavan, EuroS&P
   2019, CryptoVerif). What is modelled is ours: where each end gets the
   other's key and the preshared key.

   Keys (lane A2AFINAL2, E2EEPROOF finding 5): the pair key is the exit's
   A2A key, the owner's root key R or a machine key mk(R, id) (nfltr
   a2akeys.Derive); a root client derives the machine key of the key id the
   relay names (x-wg-peer-key-id: the relay's word, as A2A's learned
   machine) only when it is the machine the client named (lane
   ROOTNAMEPIN): the machine id of an agent ref m-<id>-<service>, or the
   id the client's own machine store holds for <machine name>.<service>;
   a bare service name names the root key (key id ""). A machine client
   holds its own. The preshared key binds the exit's service name, each
   end's own: the client's the one it named, the exit's its own; neither
   takes a name from the relay.

   Code (github.com/nfltr/relay unless named):
     client/wg/keys.go PresharedKey   p = HMAC(K, "nfltr-wg-psk-v2" 0 service 0 key id)
     client/wg/tunnel.go              the peer's key and p set on the peer; p on every handshake
     client/agent/wgexit/wgexit.go    the exit says x-wg-paired and x-wg-key-id, sets its own p
     proto/wire/wgwire/wgwire.go      x-wg-paired is advisory: each end applies its own p
     relay-server frontend/wireguard  hands each end the other's key and key id (attacker here)
     nfltr cmd/nfltr/internal/wgcli   K from the key file (a2akeys)
     nfltr a2akeys PairKeys.Exit      the key id must be the machine the client named *)

(* Bindings (README "Bindings"): what the queries rely on that a relay
   could change. Each BIND:<id> has one row in
   client/agent/wgexit/wg_exit_bindings_test.go (TestWGExitModelBindings,
   make spec-bindings) that changes just that in an honest pairing and
   requires the real WireGuard handshake to fail; nfltr.* rows are the
   client's choices, in nfltr cmd/nfltr/internal/wgcli/wg_exit_bindings_test.go.
   The test fails when its rows and these ids differ.
     BIND:psk.name             pskOf(k, name, kid): each end's own name (name-unbound)
     BIND:client.psk           RootClient's p on the exit key the relay told (client-no-psk)
     BIND:exit.psk             Exit's p on the client key the relay told (exit-no-psk)
     BIND:nfltr.client.kid     kid = named: the relay's key id only for the machine named (relay-kid)
     BIND:nfltr.client.paired  p whatever x-wg-paired says (psk-dropped-on-relay-word)
     BIND:nfltr.key.machine    machineKey(R, id): one key per machine (group-key) *)

free c: channel.

type exponent.
type G.
const g: G [data].
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).

type psk.
fun hpsk(bitstring, bitstring, bitstring): psk.   (* PresharedKey: HMAC(K, service, key id) *)
const noPsk: psk.                          (* no key file: the all-zero psk *)
fun kdf(G, G, psk): bitstring.             (* Noise IKpsk2 transport key, idealised *)
fun senc(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; sdec(senc(m, k), k) = m.

fun mk(bitstring, bitstring): bitstring.   (* a2akeys.Derive(root, id) *)
const rootKid: bitstring.                  (* the root key's key id "" *)
const groupId: bitstring.
const unbound: bitstring.
const m1, m2, m3, mL: bitstring.           (* machines: home1's, a second home1's, home3's and office3's, a leaked one *)
const home1, home2, home3, office3, home5: bitstring.

(* The machine key of id: one per machine (ONLY:group-key: one for all,
   the pairing file as a group secret). *)
letfun machineKey(r: bitstring, id: bitstring) = mk(r, id). (* NOT:group-key *)
letfun machineKey(r: bitstring, id: bitstring) = mk(r, groupId). (* ONLY:group-key *)

(* The preshared key of a key, an exit's service and its key id
   (ONLY:name-unbound: the service is not bound, v1's SHA-256 of the file). *)
letfun pskOf(k: bitstring, name: bitstring, kid: bitstring) = hpsk(k, name, kid). (* NOT:name-unbound *)
letfun pskOf(k: bitstring, name: bitstring, kid: bitstring) = hpsk(k, unbound, kid). (* ONLY:name-unbound *)

free payloadUnpaired: bitstring [private].

event ClientSend(bitstring, bitstring, bitstring, G, G, bitstring).   (* exit name, machine named, key id, client key, exit key told, payload *)
event ExitRecv(bitstring, bitstring, G, G, bitstring).     (* exit name, key id, client key told, exit key, payload *)
event Leaked(bitstring).

(* The exit: holds key k with key id kid, publishes its key and key id on
   its own session, learns a client's key from PeerUpdate (the relay's),
   answers a handshake from that key. *)
let Exit(name: bitstring, kid: bitstring, k: bitstring, b: exponent, paired: bool) =
  out(c, (exp(g, b), kid));
  in(c, peer: G);                           (* PeerUpdate: the relay's word *)
  in(c, ex: G);
  new y: exponent;
  out(c, exp(g, y));
  let p = if paired then pskOf(k, name, kid) else noPsk in (* NOT:exit-no-psk *)
  let p = noPsk in (* ONLY:exit-no-psk *)
  let sk = kdf(exp(peer, b), exp(ex, y), p) in
  in(c, e: bitstring);
  let m = sdec(e, sk) in
  event ExitRecv(name, kid, peer, exp(g, b), m).

(* A root client: names an exit (service name) on machine named (rootKid:
   a bare name, the root key), takes the key and key id the relay answers
   with (x-wg-peer-pubkey, x-wg-peer-key-id) and the relay's x-wg-paired,
   refuses a key id that is not the machine it named (ONLY:relay-kid:
   takes the relay's, the code before lane ROOTNAMEPIN), derives the key of
   that key id and applies its own p. *)
let RootClient(name: bitstring, named: bitstring, r: bitstring, a: exponent) =
  out(c, (name, exp(g, a)));
  in(c, (peer: G, kid: bitstring, peerPaired: bool));
  if kid = named then (* NOT:relay-kid *)
  new m: bitstring;
  let k = if kid = rootKid then r else machineKey(r, kid) in
  let p = pskOf(k, name, kid) in              (* x-wg-paired never changes p (wgwire.go) *) (* NOT:psk-dropped-on-relay-word *)
  let p = if peerPaired then pskOf(k, name, kid) else noPsk in (* ONLY:psk-dropped-on-relay-word *)
  let p = noPsk in (* ONLY:client-no-psk *)
  new x: exponent;
  out(c, exp(g, x));
  in(c, ey: G);
  let sk = kdf(exp(peer, a), exp(ey, x), p) in
  event ClientSend(name, named, kid, exp(g, a), peer, m);
  out(c, senc(m, sk)).

(* An unpaired client: no key file. *)
let PlainClient(name: bitstring, a: exponent, m: bitstring) =
  out(c, (name, exp(g, a)));
  in(c, (peer: G, kid: bitstring, peerPaired: bool));
  new x: exponent;
  out(c, exp(g, x));
  in(c, ey: G);
  let sk = kdf(exp(peer, a), exp(ey, x), noPsk) in
  out(c, senc(m, sk)).

(* 1. paired: a client's payload is secret unless the machine it named is
   leaked (lane ROOTNAMEPIN; before, "unless the key id the relay names is
   a leaked machine's") *)
(* expect true *)
query n: bitstring, mach: bitstring, kid: bitstring, pc: G, pe: G, m: bitstring;
  event(ClientSend(n, mach, kid, pc, pe, m)) && attacker(m) ==> event(Leaked(mach)).
(* 2. paired: the exit's payload is from a client that named that exit and
   its machine (the key id), on both keys, injective; home1 on machines m1
   and m2, home5 with the root key *)
(* expect true *)
query kid: bitstring, pc: G, pe: G, m: bitstring;
  inj-event(ExitRecv(home1, kid, pc, pe, m)) ==> inj-event(ClientSend(home1, kid, kid, pc, pe, m)).
(* expect true *)
query kid: bitstring, pc: G, pe: G, m: bitstring;
  inj-event(ExitRecv(home5, kid, pc, pe, m)) ==> inj-event(ClientSend(home5, kid, kid, pc, pe, m)).
(* 3. unpaired: the relay hands each end its own key and reads everything
   (the documented MITM: docs/e2ee.md "Track B") *)
(* expect false *)
query attacker(payloadUnpaired).
(* 4. finding 5: two exits on one machine (one key), a relay reroutes a
   client of "home3" to "office3": the exit that got it is the one the
   client named *)
(* expect true *)
query kid: bitstring, pc: G, pe: G, m: bitstring;
  event(ExitRecv(office3, kid, pc, pe, m)) ==> event(ClientSend(office3, kid, kid, pc, pe, m)).
(* 5. a leaked machine key reaches no other machine's exit: a client that
   named home1 on m1, whatever key id the relay names *)
(* expect true *)
query kid: bitstring, pc: G, pe: G, m: bitstring;
  event(ClientSend(home1, m1, kid, pc, pe, m)) && attacker(m) ==> false.
(* 6. the key id a client used names the machine it named (lane
   ROOTNAMEPIN) *)
(* expect true *)
query n: bitstring, mach: bitstring, kid: bitstring, pc: G, pe: G, m: bitstring;
  event(ClientSend(n, mach, kid, pc, pe, m)) ==> mach = kid.
(* 7-8. reachability: a paired payload arrives at home1 on m1, and at the
   second home1, on m2 (the model is not vacuous) *)
(* expect false *)
query pc: G, pe: G, m: bitstring; event(ExitRecv(home1, m1, pc, pe, m)).
(* expect false *)
query pc: G, pe: G, m: bitstring; event(ExitRecv(home1, m2, pc, pe, m)).

process
  new R: bitstring;
  new b1: exponent; new b2: exponent; new b3: exponent; new b5: exponent; new b6: exponent;
  new a1: exponent; new a2: exponent; new a3: exponent; new a5: exponent;
  new b7: exponent; new a6: exponent;
  (
    (!Exit(home1, m1, machineKey(R, m1), b1, true)) | (!RootClient(home1, m1, R, a1))
    | (!Exit(home1, m2, machineKey(R, m2), b7, true)) | (!RootClient(home1, m2, R, a6))
    | (!Exit(home2, rootKid, R, b5, false)) | (!PlainClient(home2, a5, payloadUnpaired))
    | (!Exit(home3, m3, machineKey(R, m3), b2, true)) | (!Exit(office3, m3, machineKey(R, m3), b3, true))
    | (!RootClient(home3, m3, R, a2))
    | (!Exit(home5, rootKid, R, b6, true)) | (!RootClient(home5, rootKid, R, a3))
    | (event Leaked(mL); out(c, machineKey(R, mL)))
  )
