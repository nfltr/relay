(* Copyright 2026 nfltr
   SPDX-License-Identifier: Apache-2.0

   wg_exit.pv: Track B, a WireGuard client and its exit (nfltr wg connect,
   wg socks5 <-> an agent's wgexit). spec/proverif/README.md "wg_exit.pv".

   The attacker owns the relay(s), the network and every key the relay hands
   out: x-wg-peer-pubkey to the client, PeerUpdate to the exit, x-wg-paired
   to both. With two relays (client on one, exit on another, or a relay
   rerouting the client to a third machine) the attacker owns both: one
   Dolev-Yao attacker is the colluding case and so covers each alone.

   Noise IKpsk2 (WireGuard) is not re-proven: a handshake between static key
   a and the peer key B it was told, with preshared key p, gives the
   transport key kdf(DH(a,B), DH(ephemerals), p) known only to the holder of
   B's private key that uses the same p (Donenfeld and Milner, Tamarin 2017;
   Dowling and Paterson, ACNS 2018; Lipp, Blanchet and Bhargavan, EuroS&P
   2019, CryptoVerif). What is modelled is ours: where each end gets the
   other's key and the preshared key.

   Code (github.com/nfltr/relay unless named):
     client/wg/keys.go:90          p = SHA-256("nfltr-wg-psk-v1" || pairing secret)
     client/wg/tunnel.go:361,377   the peer's key and p set on the peer; p on every handshake
     client/agent/wgexit/wgexit.go:153,188  the exit says x-wg-paired, sets its own p
     proto/wire/wgwire/wgwire.go:36  x-wg-paired is advisory: each end applies its own p
     relay-server frontend/wireguard  hands each end the other's key (attacker here) *)

free c: channel.

type exponent.
type G.
const g: G [data].
fun exp(G, exponent): G.
equation forall x: exponent, y: exponent; exp(exp(g, x), y) = exp(exp(g, y), x).

type psk.
fun pskOf(bitstring): psk.                (* keys.go:90 *)
const noPsk: psk.                          (* no pairing file: the all-zero psk *)
fun kdf(G, G, psk): bitstring.             (* Noise IKpsk2 transport key, idealised *)
fun senc(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; sdec(senc(m, k), k) = m.

const home1, home2, home3, office3, home4: bitstring.

(* Each scenario has its own payload, so one model shows what holds and what
   does not. *)
free payloadPaired: bitstring [private].
free payloadUnpaired: bitstring [private].
free payloadGroup: bitstring [private].
free payloadLeak: bitstring [private].

event ClientSend(bitstring, G, G, bitstring).   (* exit name, client key, exit key told, payload *)
event ExitRecv(bitstring, G, G, bitstring).     (* exit name, client key told, exit key, payload *)

(* The exit: publishes its key on its own session, learns a client's key from
   PeerUpdate (the relay's), answers a handshake from that key. *)
let Exit(name: bitstring, b: exponent, p: psk) =
  out(c, exp(g, b));
  in(c, peer: G);                           (* PeerUpdate: the relay's word *)
  in(c, ex: G);
  new y: exponent;
  out(c, exp(g, y));
  let k = kdf(exp(peer, b), exp(ex, y), p) in (* NOT:exit-no-psk *)
  let k = kdf(exp(peer, b), exp(ex, y), noPsk) in (* ONLY:exit-no-psk *)
  in(c, e: bitstring);
  let m = sdec(e, k) in
  event ExitRecv(name, peer, exp(g, b), m).

(* The client: names an exit, takes the key the relay answers with
   (x-wg-peer-pubkey) and the relay's x-wg-paired, applies its own p. *)
let Client(name: bitstring, a: exponent, p: psk, m: bitstring) =
  out(c, (name, exp(g, a)));
  in(c, (peer: G, peerPaired: bool));
  let p2 = p in                             (* x-wg-paired never changes p (wgwire.go:36) *) (* NOT:psk-dropped-on-relay-word *)
  let p2 = if peerPaired then p else noPsk in (* ONLY:psk-dropped-on-relay-word *)
  new x: exponent;
  out(c, exp(g, x));
  in(c, ey: G);
  let k = kdf(exp(peer, a), exp(ey, x), p2) in (* NOT:client-no-psk *)
  let k = kdf(exp(peer, a), exp(ey, x), noPsk) in (* ONLY:client-no-psk *)
  event ClientSend(name, exp(g, a), peer, m);
  out(c, senc(m, k)).

(* 1. paired: secrecy and injective agreement on both keys and the payload *)
(* expect true *)
query attacker(payloadPaired).
(* expect true *)
query pc: G, pe: G, m: bitstring;
  inj-event(ExitRecv(home1, pc, pe, m)) ==> inj-event(ClientSend(home1, pc, pe, m)).
(* 2. unpaired: the relay hands each end its own key and reads everything
   (the documented MITM: docs/e2ee.md "Track B") *)
(* expect false *)
query attacker(payloadUnpaired).
(* 3. one pairing file on two exits: a relay reroutes a client of "home" to
   "office"; the payload stays secret from the relay, but the exit the
   client named is not the exit that got it *)
(* expect true *)
query attacker(payloadGroup).
(* expect false *)
query pc: G, pe: G, m: bitstring;
  event(ExitRecv(office3, pc, pe, m)) ==> event(ClientSend(office3, pc, pe, m)).
(* 4. the pairing file is a group secret: a leaked client (its file) lets
   the relay in the middle of every other client of that exit *)
(* expect false *)
query attacker(payloadLeak).

process
  new kPaired: bitstring; new kGroup: bitstring; new kLeak: bitstring;
  new b1: exponent; new a1: exponent;
  new b2: exponent; new b3: exponent; new a2: exponent;
  new b4: exponent; new a4: exponent; new b5: exponent; new a5: exponent;
  (
    (* 1 *) (!Exit(home1, b1, pskOf(kPaired))) | (!Client(home1, a1, pskOf(kPaired), payloadPaired))
    (* 2 *) | (!Exit(home2, b5, noPsk)) | (!Client(home2, a5, noPsk, payloadUnpaired))
    (* 3 *) | (!Exit(home3, b2, pskOf(kGroup))) | (!Exit(office3, b3, pskOf(kGroup)))
            | (!Client(home3, a2, pskOf(kGroup), payloadGroup))
    (* 4 *) | (!Exit(home4, b4, pskOf(kLeak))) | (!Client(home4, a4, pskOf(kLeak), payloadLeak))
            | out(c, kLeak)
  )
