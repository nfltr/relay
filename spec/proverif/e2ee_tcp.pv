(* Copyright 2026 nfltr
   SPDX-License-Identifier: Apache-2.0

   e2ee_tcp.pv: Track A, pinned TCP sessions (nfltr dial/tcp-connect/ssh-proxy
   --pin, pin: on a connect: mapping) to an agent that ends TLS with its own
   E2EE certificate (nfltr tcp --e2ee, a service table's e2ee: true service).
   spec/proverif/README.md "e2ee_tcp.pv".

   The attacker owns the relay(s) (the session open, its E2Ee flag, its
   TargetAddr, the answer), the network and anything the relay shows (the
   dashboard's advertised fingerprint); two relays are one attacker. TLS 1.3
   is not re-proven: a client that checked the server's certificate key
   against its pin shares a fresh key only with that key's holder
   (Cremers et al., IEEE S&P 2017, Tamarin; Bhargavan et al., IEEE S&P
   2017, ProVerif/CryptoVerif). What is modelled is ours: where the pin
   comes from, the pin check, the open's answer, the agent's choice of the
   target, rotation.

   Code (nfltr = github.com/nfltr/nfltr; the rest github.com/nfltr/relay):
     client/relaytrust/relaytrust.go:29-46   pin = SHA-256 of the leaf certificate DER
     nfltr cmd/nfltr/internal/transportcli/tcp_connect_session.go:117      E2Ee = pin != ""
     nfltr .../tcp_connect_session.go:133-141  no answer: a pinned session is refused
     nfltr .../tcp_connect_session.go:195-209  TLS 1.3, VerifyPeerCertificate: fingerprint == pin
     nfltr cmd/nfltr/internal/upcli/agent.go:135 the pin comes from the agent's own output
     client/agent/session_plan.go:76,89-90    target: the table's, --forward's, else the relay's TargetAddr
     client/agent/session_plan.go:104-118     E2EE only: pinned -> TLS here, unpinned refused
     client/agent/session_plan.go:113-114     E2EE only without --forward: a pinned session refused (finding 1)
     client/agent/agent.go:351-353            TCPE2EEOnly without TCPForwardAddr: Connect fails
     client/agent/session_plan.go:333-345     serveE2EETCP: TLS, then the plaintext to the dialled target
     client/agent/tls.go:165-179              no client authentication
     client/agent/tls.go:202-216              rotateCert: one certificate at a time *)

free c: channel.

type skey.
type pkey.
fun pk(skey): pkey.
fun fp(pkey): bitstring.            (* SHA-256 of the certificate (its key here) *)
fun aenc(bitstring, pkey): bitstring.
reduc forall m: bitstring, k: skey; adec(aenc(m, pk(k)), k) = m.
fun senc(bitstring, bitstring): bitstring.
reduc forall m: bitstring, k: bitstring; sdec(senc(m, k), k) = m.

const svcAddr: bitstring.           (* the target the agent means: its table's, --forward's *)
const answerOK, answerNone: bitstring.
const c2s, s2c: bitstring.            (* TLS keys each direction apart *)

free payloadFixed, payloadRelayTarget, payloadNew, payloadOld, payloadTofu: bitstring [private].
free svcData: bitstring [private].  (* what the agent's service answers anyone *)

event ClientRecv(bitstring, bitstring, bitstring).   (* pin, session key, response *)
event AgentSent(bitstring, bitstring, bitstring).    (* fp of its key, session key, response *)
event ServiceGot(bitstring).
free sk1: skey [private].

(* The pinned client: opens with E2Ee set, needs the relay's answer, runs
   TLS with the agent inside the session, accepts only its pin. *)
let Client(pin: bitstring, m: bitstring) =
  out(c, (svcAddr, true));                           (* the open: target and E2Ee *)
  in(c, answer: bitstring);
  if answer = answerOK then                          (* tcp_connect_session.go:133-141 *) (* NOT:plaintext-without-answer *)
  if answer = answerNone then out(c, m) else (* ONLY:plaintext-without-answer *)
  in(c, spk: pkey);                                  (* the certificate the session presents *)
  let pin2 = pin in                                  (* the pin is the client's own, never the relay's *) (* NOT:relay-supplied-pin *)
  in(c, pin2: bitstring); (* ONLY:relay-supplied-pin *)
  if fp(spk) = pin2 then                             (* tcp_connect_session.go:204 *) (* NOT:skip-pin-check *)
  if true then (* ONLY:skip-pin-check *)
  new k: bitstring;
  out(c, aenc(k, spk));
  out(c, senc((c2s, m), k));
  in(c, e: bitstring);
  let (=s2c, r: bitstring) = sdec(e, k) in (* NOT:agreement-without-key-check *)
  in(c, r: bitstring); (* ONLY:agreement-without-key-check *)
  event ClientRecv(pin, k, r).

(* The agent: E2EE only; refuses an unpinned session; after TLS bridges the
   plaintext to the target. fixed = the agent has a target of its own (a
   service table, --forward); without one a pinned session is refused, the
   open's target being the relay's. relay-names-target: before finding 1's
   fix, the agent without one dialled the open's target. *)
let Agent(sk: skey, fixed: bool) =
  in(c, (target: bitstring, e2ee: bool));
  if e2ee = true then                                (* session_plan.go:120-125: unpinned refused *)
  let t0 = if fixed then svcAddr else target in (* ONLY:relay-names-target *)
  if fixed = true then                               (* session_plan.go:113-114: no fixed target, refused *) (* NOT:relay-names-target *)
  let t0 = svcAddr in                                (* session_plan.go:76,89-90 *) (* NOT:relay-names-target *)
  let t = t0 in (* NOT:relay-names-target-with-forward *)
  let t = target in (* ONLY:relay-names-target-with-forward *)
  out(c, pk(sk));
  in(c, ek: bitstring);                              (* no client authentication (tls.go:165-179) *)
  let k = adec(ek, sk) in
  in(c, e: bitstring);
  let (=c2s, m: bitstring) = sdec(e, k) in
  if t = svcAddr then (
    event ServiceGot(m);                            (* to its own service, on its machine *)
    new r: bitstring;
    event AgentSent(fp(pk(sk)), k, (r, svcData));
    out(c, senc((s2c, (r, svcData)), k))
  ) else
    out(c, (t, m)).                                  (* dialTarget: another host, the attacker's *)

(* 1. a pin from the agent's own output, a target the agent fixed *)
(* expect true *)
query attacker(payloadFixed).
(* expect true *)
query k: bitstring, r: bitstring;
  inj-event(ClientRecv(fp(pk(sk1)), k, r)) ==> inj-event(AgentSent(fp(pk(sk1)), k, r)).
(* 2. nfltr tcp --e2ee without --forward: the relay names the target; the
   agent refuses the session (finding 1 fixed: before, it dialled the
   relay's target and sent it the client's plaintext; mutant
   relay-names-target) *)
(* expect true *)
query attacker(payloadRelayTarget).
(* 3. rotation: the old key leaks after RotateE2EECert; a client pinned to
   the new certificate keeps its secrecy, one still pinned to the old one
   does not (a pin is not revoked by a rotation: re-pin) *)
(* expect true *)
query attacker(payloadNew).
(* expect false *)
query attacker(payloadOld).
(* 4. first use: a pin taken from what the relay shows (the dashboard, a
   page the relay serves) protects nothing; likewise nfltr shell's SSH host
   key on first use (OpenSSH known_hosts TOFU; a new key at every start
   without --host-key) *)
(* expect false *)
query attacker(payloadTofu).
(* 5. LIMIT: no client authentication: the relay opens a pinned session of
   its own and gets the agent's service; E2EE only is not access control
   against the relay *)
(* expect false *)
query attacker(svcData).

process
  new sk2: skey; new skOld: skey; new skNew: skey; new sk4: skey;
  (
    (* 1 *) (!Agent(sk1, true)) | (!Client(fp(pk(sk1)), payloadFixed))
    (* 2 *) | (!Agent(sk2, false)) | (!Client(fp(pk(sk2)), payloadRelayTarget))
    (* 3 *) | (!Agent(skNew, true)) | (!Client(fp(pk(skNew)), payloadNew))
            | (!Client(fp(pk(skOld)), payloadOld)) | out(c, skOld)
    (* 4 *) | (!Agent(sk4, true)) | (in(c, relayPin: bitstring); !Client(relayPin, payloadTofu))
  )
