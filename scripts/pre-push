#!/usr/bin/env bash
# Copyright 2026 nfltr
# SPDX-License-Identifier: Apache-2.0
#
# pre-push: `make ci` (scripts/ci.sh) on the exact commit pushed to main or
# to a tag; other refs push unchecked. A commit whose tree already has a ci
# pass stamp (an earlier `make ci` or push of the same tree) is not run
# again. The commit runs in place when it is HEAD of a clean checkout, else in
# a throwaway worktree. Installed by `make hooks` (.git/hooks/pre-push calls
# this file, so it stays current with the checkout).
#
# Bypass: NFLTR_CI_BYPASS="<reason>" git push ...  Each bypassed ref is
# logged to <git-common-dir>/ci-bypass.log and to stderr; the Linux runner
# still tests the pushed commit after the push.
set -uo pipefail

remote="${1:-}"
root="$(git rev-parse --show-toplevel)" || exit 1
common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
rc=0
while read -r _lref lsha rref _rsha; do
	case "$rref" in refs/heads/main | refs/tags/*) ;; *) continue ;; esac
	case "$lsha" in *[!0]*) ;; *) continue ;; esac # a delete
	sha="$(git rev-parse -q --verify "$lsha^{commit}")" || continue
	short="$(git rev-parse --short "$sha")"
	if [ -n "${NFLTR_CI_BYPASS:-}" ]; then
		line="$(date -u +%Y-%m-%dT%H:%M:%SZ) bypass $remote $rref $sha user=$(git config user.email || id -un) reason=$NFLTR_CI_BYPASS"
		echo "$line" >>"$common/ci-bypass.log"
		echo "pre-push: make ci BYPASSED for $rref $short ($NFLTR_CI_BYPASS), logged to $common/ci-bypass.log" >&2
		continue
	fi
	if "$root/scripts/ci.sh" verified "$sha"; then
		echo "pre-push: $rref $short: make ci verified for this exact tree" >&2
		continue
	fi
	echo "pre-push: $rref $short: make ci (bypass: NFLTR_CI_BYPASS=<reason>)" >&2
	if [ "$(git rev-parse HEAD)" = "$sha" ] && [ -z "$(git status --porcelain)" ]; then
		make -C "$root" ci </dev/null >&2 || rc=1
	else
		wt="$(mktemp -d)/ci-$short"
		git worktree add -q --detach "$wt" "$sha" >&2 || exit 1
		make -C "$wt" ci </dev/null >&2 || rc=1
		git worktree remove --force "$wt" && rmdir "$(dirname "$wt")"
	fi
	[ $rc -eq 0 ] || { echo "pre-push: make ci failed for $rref $short: push refused" >&2; exit 1; }
	# git opened the connection before this hook; a long run can outlast it.
	echo "pre-push: $rref $short: make ci passed and is stamped; if the push now fails or pushes nothing, push again" >&2
done
exit $rc
