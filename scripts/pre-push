#!/usr/bin/env bash
# Copyright 2026 nfltr
# SPDX-License-Identifier: Apache-2.0
#
# pre-push: every ref's new commits and tags are nfltr's (check-identity.sh);
# and a push to main or a tag needs nfltr's Linux CI runner's green result for
# that exact commit (owner 2026-11-02: the runner is the gate; the Mac runs
# no tests here). Push the commit to a branch, `make ci-request REPO=<repo>
# REF=<sha>` in nfltr, wait for green, then push main. Installed by `make
# hooks` (.git/hooks/pre-push calls this file).
#
# Bypass: NFLTR_CI_BYPASS="<reason>" git push ...  Each bypassed ref is
# logged to <git-common-dir>/ci-bypass.log and to stderr; the Linux runner
# still tests the pushed commit after the push.
set -uo pipefail

remote="${1:-}"
root="$(git rev-parse --show-toplevel)" || exit 1
common="$(cd "$(git rev-parse --git-common-dir)" && pwd)"
results="${NFLTR_CI_RESULTS:-$HOME/.local/state/nfltr-linux-node/ci/results.jsonl}"
rc=0
while read -r _lref lsha rref rsha; do
	# Public: every ref's new commits and tags are nfltr's (no bypass).
	case "$lsha" in *[!0]*)
		"$root/scripts/check-identity.sh" "$lsha" "$rsha" ||
			{ echo "pre-push: $rref: a commit or tag not by nfltr <oss@nfltr.xyz> (public repository): push refused" >&2; exit 1; } ;;
	esac
	case "$rref" in refs/heads/main | refs/tags/*) ;; *) continue ;; esac
	case "$lsha" in *[!0]*) ;; *) continue ;; esac # a delete
	sha="$(git rev-parse -q --verify "$lsha^{commit}")" || continue
	short="$(git rev-parse --short "$sha")"
	if [ -n "${NFLTR_CI_BYPASS:-}" ]; then
		line="$(date -u +%Y-%m-%dT%H:%M:%SZ) bypass $remote $rref $sha user=$(git config user.email || id -un) reason=$NFLTR_CI_BYPASS"
		echo "$line" >>"$common/ci-bypass.log"
		echo "pre-push: gate BYPASSED for $rref $short ($NFLTR_CI_BYPASS), logged to $common/ci-bypass.log" >&2
		continue
	fi
	if ! grep -F "\"repo\":\"relay\",\"sha\":\"$sha\"" "$results" 2>/dev/null | grep -qF '"ok":true'; then
		echo "pre-push: $rref $short: no green Linux runner result for this commit: push it to a branch, make ci-request REPO=relay REF=$sha in nfltr, wait for green (make ci-status), push again" >&2
		exit 1
	fi
	echo "pre-push: $rref $short: green on the Linux runner" >&2
done
exit $rc
